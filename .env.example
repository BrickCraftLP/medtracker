VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Optional: raw URL of the hosted changelog.json (update log).
# If unset, the bundled fallback in src/data/changelog.js is used.
# e.g. https://raw.githubusercontent.com/<user>/<repo>/main/changelog.json
VITE_CHANGELOG_URL=
# Cloudflare Turnstile site key (public, safe to expose client-side).
# The matching secret key is never stored in this codebase — it's entered
# directly in Supabase Auth (Authentication → Settings → Bot and Abuse
# Protection → Turnstile), which verifies tokens for you.
VITE_TURNSTILE_SITE_KEY=
# Web Push public VAPID key (public, safe client-side). Generate the key pair
# with `node scripts/generate-vapid-keys.mjs` — the private key goes into the
# Supabase Edge Function secrets only, never here.
VITE_VAPID_PUBLIC_KEY=
# Local only — put it in .env.local and never prefix it with VITE_. Lets
# `npm run deploy` send the "new version" push; same value as CRON_SECRET.
# PUSH_DISPATCH_SECRET=

# Google Calendar / Tasks sync. OAuth 2.0 *Web application* client ID from the
# Google Cloud Console (public, safe client-side).
# Add your origins under "Authorised JavaScript origins", e.g.
#   http://localhost:5173  and  https://<your-domain>
# Enable both the "Google Calendar API" and the "Google Tasks API" in the same
# Cloud project.
# The client SECRET never goes here: it belongs to the google-oauth Edge
# Function, which keeps the refresh token so users connect only once:
#   supabase secrets set GOOGLE_CLIENT_ID=<same id> GOOGLE_CLIENT_SECRET=<secret>
#   supabase functions deploy google-oauth
# and run supabase_migration_google_oauth.sql. While the OAuth consent screen
# is in "Testing", Google expires refresh tokens after 7 days — publish it.
# Leave empty to hide calendar sync from the UI entirely.
VITE_GOOGLE_CLIENT_ID=
